# Copy to .env and fill in your values:
#   cp .env.example .env

# --- MaxMind GeoLite2 (https://www.maxmind.com/en/account) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Path to GeoLite2-Country.mmdb (download: .\scripts\download-geolite2.ps1)
GEOIP_DATABASE_PATH=C:/path/to/shortly/data/GeoLite2-Country.mmdb

# --- Database ---
SPRING_DATASOURCE_PASSWORD=12345678

# --- JWT ---
APP_JWT_SECRET=change-me-to-a-long-random-string
